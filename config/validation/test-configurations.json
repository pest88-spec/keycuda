  "configuration_rules": {
    "required_fields": ["description", "category", "critical", "default_timeout", "validation_logic", "success_criteria"],
    "timeout_limits": {
      "min_timeout": 60,
      "max_timeout": 7200
    },
    "retry_limits": {
      "min_retries": 0,
      "max_retries": 5
    },
    "dependency_validation": true,
    "circular_dependency_check": true
  },
  "test_categories": {
    "dependency": "Dependency management and versioning",
    "build": "Build system and compilation",
    "runtime": "Runtime functionality and execution",
    "performance": "Performance metrics and benchmarking",
    "compatibility": "System and dependency compatibility",
    "security": "Security vulnerability scanning",
    "integration": "Integration testing",
    "stress": "Stress and load testing",
    "memory": "Memory management and leak detection",
    "cross_platform": "Cross-platform compatibility"
  },
  "execution_order": [
    "dependency_check",
    "build_check",
    "basic_runtime",
    "comprehensive_runtime",
    "performance_baseline",
    "performance_regression",
    "compatibility_check",
