+cudaError_t CudaDeviceKeys::updatePrivateKeys(const std::vector<secp256k1::uint256> &privateKeys)
+{
+	size_t expected = static_cast<size_t>(_blocks) * _threads * _pointsPerThread;
+	if(privateKeys.size() != expected) {
+		return cudaErrorInvalidValue;
+	}
+
+	if(_devPrivate == NULL || _devChain == NULL) {
+		return cudaErrorInvalidDevicePointer;
+	}
+
+	unsigned int *tmp = new unsigned int[expected * 8];
+
+	for(int block = 0; block < _blocks; block++) {
+		for(int thread = 0; thread < _threads; thread++) {
+			for(int idx = 0; idx < _pointsPerThread; idx++) {
+
+				int index = getIndex(block, thread, idx);
+				splatBigInt(tmp, block, thread, idx, privateKeys[index]);
+			}
+		}
+	}
+
+	cudaError_t err = cudaMemcpy(_devPrivate,
+							 tmp,
+							 expected * sizeof(unsigned int) * 8,
+							 cudaMemcpyHostToDevice);
+
+	delete[] tmp;
+
+	if(err) {
+		return err;
+	}
+
+	std::size_t chain_words = static_cast<std::size_t>(_blocks) * _threads * _pointsPerThread * 8;
+	err = cudaMemset(_devChain, 0, chain_words * sizeof(unsigned int));
+	if(err) {
+		return err;
+	}
+
+	_step = 0;
+	return cudaSuccess;
+}
